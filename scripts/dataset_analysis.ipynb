    "import json\n",
    "import os\n",
    "import pandas as pd\n",
    "from scipy.stats import pearsonr\n",
    "\n",
    "def calculate_covariance_coef(df, link):\n",
    "    df_cleaned = df.dropna(subset=['Throughput'])\n",
    "\n",
    "    mean_throughput = df_cleaned['Throughput'].mean()\n",
    "    std_dev_throughput = df_cleaned['Throughput'].std()\n",
    "\n",
    "    cv_throughput = (std_dev_throughput / mean_throughput) * 100\n",
    "\n",
    "    print(f\"The Throughput Coefficient of Variation (CV) for {link} is: {cv_throughput:.2f}%\")\n",
    "\n",
    "    return cv_throughput\n",
    "\n",
    "def nrmse_variance_analysis(original_path, tecnicas, imputed_path, longest_imputed_path, model, rmse_results='../results/rmse_choosen_files.json', choosen_files='../results/20_choosen_files.json'):\n",
    "    \n",
    "    with open(choosen_files, 'r') as f:\n",
    "        choosen_files_list = json.load(f)\n",
    "\n",
    "    with open(rmse_results, 'r') as f:\n",
    "        file_data = json.load(f)\n",
    "\n",
    "    with open('../results/evaluation_rmse_mae_2.json', 'r') as f:\n",
    "        file_data_forecasting = json.load(f)\n",
    "\n",
    "    results = {}\n",
    "\n",
    "    for tecnica in tecnicas:\n",
    "        for file in choosen_files_list:\n",
    "            rmse = file_data[file][tecnica][\"Throughput\"]\n",
    "            path = imputed_path + '/' + tecnica + '/' + file\n",
    "            path_longest = longest_imputed_path + '/' + tecnica +  '/' + file\n",
    "            print(f'File Path: {path}')\n",
    "\n",
    "            if not os.path.exists(path):\n",
    "                print('Path not found.')\n",
    "                return\n",
    "            \n",
    "            df_longest = pd.read_csv(path_longest)\n",
    "            range_val_longest = df_longest['Throughput'].dropna().max() - df_longest['Throughput'].dropna().min()\n",
    "            rmse = rmse / 1000000\n",
    "            nrmse = rmse / range_val_longest if range_val_longest != 0 else None\n",
    "            print(f'NMRSE {nrmse}')\n",
    "\n",
    "            df = pd.read_csv(path)\n",
    "            name_on_forecasting_rmse = f'{tecnica} - {file}, {model}'\n",
    "            if name_on_forecasting_rmse in file_data_forecasting:\n",
    "                rmse_forecasting = file_data_forecasting[name_on_forecasting_rmse][\"RMSE\"]\n",
    "            else:\n",
    "                continue\n",
    "            range_val = df['Throughput'].dropna().max() - df['Throughput'].dropna().min()\n",
    "            nrmse_forecasting = rmse_forecasting / range_val if range_val != 0 else None\n",
    "            print(f'NMRSE forecasting {nrmse_forecasting}')\n",
    "\n",
    "\n",
    "            path_original = original_path + '/' + file\n",
    "            df_original = pd.read_csv(path_original)\n",
    "            cv = calculate_covariance_coef(df_original.dropna(), file)\n",
    "\n",
    "            total_nans = df_original.isna().sum().sum()\n",
    "            percentage =  total_nans / df_original.shape[0] * 100 \n",
    "\n",
    "            if model not in results:\n",
    "                results[model] = {}\n",
    "            if tecnica not in results[model]:\n",
    "                results[model][tecnica] = {}\n",
    "\n",
    "            # Save results in a dictionary\n",
    "            results[model][tecnica][file] = {\n",
    "                \"method\": tecnica,\n",
    "                \"dataset\": file,\n",
    "                \"nrmse\": nrmse,\n",
    "                \"nrmse_forecasting\": nrmse_forecasting,\n",
    "                \"cv\": cv,\n",
    "                \"nans_percentage\": percentage\n",
    "            }\n",
    "    \n",
    "    # Save results to a JSON file\n",
    "    with open('../results/nrmse_variance_analysis_results.json', 'w') as f:\n",
    "        json.dump(results, f, indent=4)\n",
    "\n",
    "    return results\n"
   ]
