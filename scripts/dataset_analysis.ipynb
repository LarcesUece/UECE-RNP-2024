    "import json\n",
    "import pandas as pd\n",
    "from tabulate import tabulate\n",
    "\n",
    "def load_and_process_data(data):\n",
    "    # Create a list to store records\n",
    "    records = []\n",
    "    \n",
    "    # Process each model (e.g., GRU, SVD, etc.)\n",
    "    for model, methods in data.items():\n",
    "        # Process each method under the model\n",
    "        for method, datasets in methods.items():\n",
    "            for dataset, metrics in datasets.items():\n",
    "                # Create a record for each dataset entry\n",
    "                record = {\n",
    "                    'model': model,\n",
    "                    'method': method,\n",
    "                    'dataset': dataset,\n",
    "                    'nrmse': float(metrics.get('nrmse', 0)),\n",
    "                    'nrmse_forecasting': float(metrics.get('nrmse_forecasting', 0)),\n",
    "                    'cv': float(metrics.get('cv', 0)),\n",
    "                    'nans_percentage': float(metrics.get('nans_percentage', 0))\n",
    "                }\n",
    "                records.append(record)\n",
    "    \n",
    "    # Convert list of records to a DataFrame\n",
    "    df = pd.DataFrame(records)\n",
    "    return df\n",
    "\n",
    "def analyze_data(df):\n",
    "    # Group by model and method to calculate statistics\n",
    "    method_stats = df.groupby(['model', 'method']).agg({\n",
    "        'nrmse': ['mean', 'std', 'min', 'max'],\n",
    "        'nrmse_forecasting': ['mean', 'std', 'min', 'max'],\n",
    "        'cv': ['mean', 'std'],\n",
    "        'nans_percentage': ['mean', 'std']\n",
    "    }).round(10)\n",
    "    \n",
    "    # Calculate correlations for each model-method combination\n",
    "    correlations = {}\n",
    "    for (model, method), method_df in df.groupby(['model', 'method']):\n",
    "        key = f\"{model}_{method}\"\n",
    "        correlations[key] = {\n",
    "            'nrmse_vs_cv': method_df['nrmse'].corr(method_df['cv']),\n",
    "            'nrmse_vs_nans': method_df['nrmse'].corr(method_df['nans_percentage']),\n",
    "            'nrmse_forecasting_vs_cv': method_df['nrmse_forecasting'].corr(method_df['cv']),\n",
    "            'nrmse_forecasting_vs_nans': method_df['nrmse_forecasting'].corr(method_df['nans_percentage']),\n",
    "            'nrmse_forecasting_vs_nrmse': method_df['nrmse_forecasting'].corr(method_df['nrmse'])\n",
    "        }\n",
    "    \n",
    "    return method_stats, correlations\n",
    "\n",
    "def print_analysis(method_stats, correlations):\n",
    "    # Print method statistics\n",
    "    print(\"\\n=== Method Performance Statistics ===\")\n",
    "    print(tabulate(method_stats, headers='keys', tablefmt='psql'))\n",
    "    \n",
    "    # Print correlations\n",
    "    print(\"\\n=== Correlations by Model-Method ===\")\n",
    "    corr_df = pd.DataFrame(correlations).round(4)\n",
    "    print(tabulate(corr_df, headers='keys', tablefmt='psql'))\n",
