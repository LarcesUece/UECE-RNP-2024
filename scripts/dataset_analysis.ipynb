    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "import matplotlib.pyplot as plt\n",
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "import seaborn as sns\n",
    "\n",
    "def analyze_time_series(df):\n",
    "    \"\"\"\n",
    "    Analyze correlation, seasonality, and trend between prediction and test columns.\n",
    "    \"\"\"\n",
    "    # Ensure DataFrame has required columns\n",
    "    if not {'Prediction', 'Test'}.issubset(df.columns):\n",
    "        raise ValueError(\"DataFrame must contain 'Prediction' and 'Test' columns.\")\n",
    "    \n",
    "    # If index column is missing, use DataFrame index\n",
    "    if 'index' not in df.columns:\n",
    "        df['index'] = range(len(df))\n",
    "\n",
    "    # Calculate correlation\n",
    "    correlation = stats.pearsonr(df['Prediction'], df['Test'])\n",
    "    \n",
    "    # Create figure with subplots\n",
    "    fig = plt.figure(figsize=(15, 12))\n",
    "    \n",
    "    # 1. Correlation scatter plot\n",
    "    plt.subplot(3, 1, 1)\n",
    "    sns.scatterplot(data=df, x='Prediction', y='Test')\n",
    "    plt.title(f'Prediction vs Test (Correlation: {correlation[0]:.3f}, p-value: {correlation[1]:.3f})')\n",
    "    plt.xlabel('Prediction')\n",
    "    plt.ylabel('Test')\n",
    "    \n",
    "    # 2. Time series plot\n",
    "    plt.subplot(3, 1, 2)\n",
    "    plt.plot(df['index'], df['Prediction'], label='Prediction', color='blue')\n",
    "    plt.plot(df['index'], df['Test'], label='Test', color='orange')\n",
    "    plt.title('Time Series Comparison')\n",
    "    plt.xlabel('Index')\n",
    "    plt.ylabel('Value')\n",
    "    plt.legend()\n",
    "    \n",
    "    # 3. Decomposition of both series\n",
    "    # Fill missing values for decomposition\n",
    "    df['Prediction'] = df['Prediction'].interpolate()\n",
    "    df['Test'] = df['Test'].interpolate()\n",
    "\n",
    "    pred_decomposition = seasonal_decompose(df['Prediction'], period=12, extrapolate_trend='freq')\n",
    "    test_decomposition = seasonal_decompose(df['Test'], period=12, extrapolate_trend='freq')\n",
    "    \n",
    "    # Plot decomposition trends\n",
    "    plt.subplot(3, 1, 3)\n",
    "    plt.plot(df['index'], pred_decomposition.trend, label='Prediction Trend', color='blue')\n",
    "    plt.plot(df['index'], test_decomposition.trend, label='Test Trend', color='orange')\n",
    "    plt.title('Trend Comparison')\n",
    "    plt.xlabel('Index')\n",
    "    plt.ylabel('Trend')\n",
    "    plt.legend()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    # Calculate additional statistics\n",
    "    stats_dict = {\n",
    "        'correlation': correlation[0],\n",
    "        'p_value': correlation[1],\n",
    "        'prediction_seasonality_strength': np.std(pred_decomposition.seasonal) / np.std(df['Prediction'] - pred_decomposition.trend),\n",
    "        'test_seasonality_strength': np.std(test_decomposition.seasonal) / np.std(df['Test'] - test_decomposition.trend),\n",
    "        'prediction_trend_direction': np.polyfit(df['index'], df['Prediction'], 1)[0],\n",
    "        'test_trend_direction': np.polyfit(df['index'], df['Test'], 1)[0]\n",
    "    }\n",
    "    \n",
    "    return stats_dict, (pred_decomposition, test_decomposition)\n",
    "\n",
    "df = pd.read_csv('../results/forecasting-values LSTM interpolacao-linear - treated bbr esmond data rs-pe 07-07-2023_longest_interval.csv')\n",
    "\n",
    "# Analyze the time series\n",
    "stats_dict, decompositions = analyze_time_series(df)\n",
    "\n",
    "# Print results\n",
    "print(\"\\nAnalysis Results:\")\n",
    "print(f\"Correlation coefficient: {stats_dict['correlation']:.3f}\")\n",
    "print(f\"P-value: {stats_dict['p_value']:.3f}\")\n",
    "print(f\"\\nSeasonality strength:\")\n",
    "print(f\"Prediction: {stats_dict['prediction_seasonality_strength']:.3f}\")\n",
    "print(f\"Test: {stats_dict['test_seasonality_strength']:.3f}\")\n",
    "print(f\"\\nTrend direction (slope):\")\n",
    "print(f\"Prediction: {stats_dict['prediction_trend_direction']:.3f}\")\n",
    "print(f\"Test: {stats_dict['test_trend_direction']:.3f}\")"
   ]
