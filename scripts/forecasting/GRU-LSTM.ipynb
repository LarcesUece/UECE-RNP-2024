    "def bits_para_megabits(df, col_vaz):\n",
    "    # Dados em MegaBits/s e fill\n",
    "    df[col_vaz] = df[col_vaz]/1000000\n",
    "    df[col_vaz] = df[col_vaz].replace(-1, df[col_vaz].mean())\n",
    "    df[col_vaz] = df[col_vaz].fillna(df[col_vaz].mean())\n",
    "\n",
    "    return df\n",
